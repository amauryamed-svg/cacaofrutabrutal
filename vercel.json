{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/pitch", "destination": "/pitch/index.html" },
    {
      "source": "/((?!pitch_growth\\.html|siembra\\.html|pitch|assets|manifest\\.json|favicon\\.svg|favicon-32\\.png|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
